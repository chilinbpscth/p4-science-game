rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      // Allow anyone to create new scores (students playing the game)
      allow create: if true;
      // Allow anyone to read scores (for public leaderboard and teacher results)
      allow read: if true;
      // Do not allow updates or deletes (protect the data)
      allow update, delete: if false;
    }
  }
}
